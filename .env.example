# npm start loads .env automatically if present; explicit environment variables win.
# Relay: leave PI_REMOTE_TOKEN unset to generate and print a fresh token at startup.
# For a stable token across restarts, uncomment and paste a previously relay-issued value.
# Pi clients must use that same value; /remote setup prompts for it, never generates it.
# PI_REMOTE_TOKEN=
# Used by the extension; HTTPS required except on localhost.
PI_REMOTE_URL=https://pi.example.com
# Relay binds locally by default; use 0.0.0.0 inside a container.
HOST=127.0.0.1
PORT=8787
# Optional: exact TCP peer IPs of trusted proxies, comma-separated.
# Proxies MUST overwrite X-Real-IP with the client IP; keep the backend private.
# For the same-machine Caddy example: PI_REMOTE_TRUSTED_PROXIES=127.0.0.1
PI_REMOTE_TRUSTED_PROXIES=

# Optional Google SSO: configure ALL four to require login for browser access.
# Put real credentials and the allowed email only in private .env (chmod 600).
# Keep the client secret out of Git and /nix/store. No public Funnel needed.
# PI_REMOTE_GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
# PI_REMOTE_GOOGLE_CLIENT_SECRET=your-client-secret
# PI_REMOTE_ALLOWED_EMAIL=owner@example.com
# PI_REMOTE_PUBLIC_URL=https://relay-host.your-tailnet.ts.net
# Register the exact URI: PI_REMOTE_PUBLIC_URL + /auth/google/callback

# Pi-side opt-in for the trusted dashboard (set in EACH Pi process, not just relay).
# This shares the session key/name with the relay and enables QR-free selection.
# PI_REMOTE_TRUST_RELAY=true
