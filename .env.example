# Relay: leave PI_REMOTE_TOKEN unset to generate and print a fresh token at startup.
# For a stable token across restarts, uncomment and paste a previously relay-issued value.
# Pi clients must use that same value; /remote setup prompts for it, never generates it.
# PI_REMOTE_TOKEN=
# Used by the extension; HTTPS required except on localhost.
PI_REMOTE_URL=https://pi.example.com
# Relay binds locally by default; use 0.0.0.0 inside a container.
HOST=127.0.0.1
PORT=8787
# Optional: exact TCP peer IPs of trusted proxies, comma-separated.
# Proxies MUST overwrite X-Real-IP with the client IP; keep the backend private.
# For the same-machine Caddy example: PI_REMOTE_TRUSTED_PROXIES=127.0.0.1
PI_REMOTE_TRUSTED_PROXIES=
